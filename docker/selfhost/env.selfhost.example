# HowFar self-host provider overlay — LOCAL ONLY.
#
# These are the ONLY env values that point the app at the local self-host stack
# (docker/selfhost/docker-compose.yml). Merge them into HowFar/.env alongside the
# normal DATABASE_URL / AUTH_SECRET (this file is a provider OVERLAY, not a full
# .env). With none of these set, the app is byte-identical to the public Bucharest
# deployment — that default MUST stay green with no stack running.
#
# Every host below matches a 127.0.0.1 port published by the compose file. Bare
# host, no trailing slash — the app appends each provider's path (see src/lib/env.ts).

# Nominatim (submit-time /search + /reverse) — compose publishes 127.0.0.1:8081->8080
NOMINATIM_BASE_URL="http://localhost:8081"

# Photon (type-ahead /api) — compose publishes 127.0.0.1:2322->2322
PHOTON_BASE_URL="http://localhost:2322"

# OpenRouteService (walk + car isochrones) — compose publishes 127.0.0.1:8082->8082.
# NOTE the /ors path prefix: the ORS docker image serves the API under /ors, and
# the app appends /v2/isochrones/{profile}. Self-hosted ORS is KEYLESS (the key
# is only sent to the public host), so ORS_API_KEY is neither needed nor sent.
ORS_BASE_URL="http://localhost:8082/ors"

# Tile archive — point at the self-host build (build-tiles.sh writes here by
# default), a DISTINCT path from the public default data/tiles/bucharest.pmtiles so
# the two never clobber each other. Both are gitignored (data/tiles/*.pmtiles).
TILES_PMTILES_PATH="data/tiles/selfhost-romania.pmtiles"

# Cold the provider cache whenever the underlying OSM extract/graph is rebuilt
# Use the pinned extract date so a rebuild from a newer extract colds
# cleanly. NB the previous generation's ApiCache rows are NOT auto-purged — pair a
# change here with `DELETE FROM "ApiCache"` (no expiry reaper yet).
PROVIDER_DATA_REVISION="romania-260824"

# You own these instances (no third-party ToS), so throttling can be disabled for
# snappy local dev. 0 = no spacing. This is ONLY safe because every *_BASE_URL
# above is a self-host host — the provider throttle guard REJECTS a sub-default
# interval while a base still points at the public host (fail-closed via /api/ready 503).
NOMINATIM_MIN_INTERVAL_MS="0"
PHOTON_MIN_INTERVAL_MS="0"
ORS_MIN_INTERVAL_MS="0"

# ── Extent (BUILD-TIME inlined — only needed to point at a different city) ────
# The default is Bucharest+Ilfov; leave unset for Bucharest. If you change it,
# rebuild the app AND rebuild the tiles + re-import the engines from the matching
# extent. build-tiles.sh + scripts/fetch-tiles.sh both read this same var.
# NEXT_PUBLIC_MAP_BBOX="25.8,44.2,26.4,44.7"
