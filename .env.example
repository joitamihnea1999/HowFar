# ── Required ────────────────────────────────────────────────────────────────
# PostgreSQL/PostGIS connection. Local dev: docker compose up -d db (port 5433).
# Railway: use the private-network URL from the PostGIS service.
DATABASE_URL="postgresql://howfar:howfar@localhost:5433/howfar"

# Optional outside local Docker: Prisma migrate dev's dedicated shadow DB.
# Production `prisma migrate deploy` does not read it.
SHADOW_DATABASE_URL="postgresql://howfar:howfar@localhost:5433/howfar_shadow"

# Auth.js session/JWT secret — ALWAYS required at runtime, even before OAuth
# providers are configured. Generate: npx auth secret  (or openssl rand -base64 32)
AUTH_SECRET=""

# ── Optional: social login (sign-in UI stays hidden while unset) ────────────
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ── Optional: providers (server-side only — never expose under NEXT_PUBLIC_) ─
# OpenRouteService key for walking isochrones (free account: openrouteservice.org)
ORS_API_KEY=""

# Optional importer failure webhook (Railway/Slack-compatible JSON receiver).
# The weekly job also exits non-zero and /api/catalogue-status returns 503 when stale.
AMENITY_IMPORT_ALERT_WEBHOOK_URL=""

# ── Region / self-host (task 007) ───────────────────────────────────────────
# Every value below is OPTIONAL and DEFAULTS to today's public host / the
# Bucharest extent — leave them unset and the app is byte-for-byte the current
# deployment. Set them to point at self-hosted instances (P2/P3) or a different
# Romanian city (P4). A SET-but-invalid value fails closed, never a silent bad
# fetch: the extent (NEXT_PUBLIC_MAP_BBOX) is validated at BUILD; the provider
# hosts are validated at readiness (/api/ready returns 503, so a bad value fails
# the deploy healthcheck) and again on first use (a clean 503, not a 500).
#
# Provider base URLs (server-side, runtime; no trailing slash; the app appends
# the provider-version path). Defaults shown.
# NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org"
# PHOTON_BASE_URL="https://photon.komoot.io/api"
# ORS_BASE_URL="https://api.openrouteservice.org"
# TRANSIT_BASE_URL="https://api.transitous.org"   # feeds both one-to-all + plan
#
# Overpass endpoint pools (comma/space-separated; first healthy host wins).
# Interactive route/stop queries (default = 3 hosts):
# OVERPASS_ENDPOINTS="https://maps.mail.ru/osm/tools/overpass/api/interpreter,https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter"
# Weekly bulk amenity import (default = 2 hosts):
# OVERPASS_BULK_ENDPOINTS="https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter"
#
# Tile archive path (server-side, runtime; absolute, or relative to cwd).
# TILES_PMTILES_PATH="data/tiles/bucharest.pmtiles"
#
# Map extent = geofence + MapLibre maxBounds + the tile extract's --bbox, all
# from this ONE var: "minLng,minLat,maxLng,maxLat". SINGLE-CITY extent (span ≤ 2°
# per axis — the transit grid is sized from it). NOTE: NEXT_PUBLIC_* is
# BUILD-TIME inlined, so changing the extent requires a rebuild (the provider
# hosts above are runtime). scripts/fetch-tiles.sh reads this same var.
# NEXT_PUBLIC_MAP_BBOX="25.8,44.2,26.4,44.7"
